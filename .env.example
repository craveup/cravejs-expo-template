# Copy to .env and fill in the values for the selected environment. `.env` is ignored.
#
# Every value in this file is embedded in the app bundle and is PUBLIC. Restrict map keys by iOS
# bundle ID and Android package/signing certificate. Never add a private Crave key, Stripe secret,
# loyalty-provider credential, customer token, cart capability, or receipt capability here.

# Exact public Crave API origin. Do not infer it from a credential or storefront host.
EXPO_PUBLIC_CRAVEUP_API_URL=

# Public tenant selectors provisioned by the platform team.
EXPO_PUBLIC_CRAVEUP_MERCHANT_SLUG=
EXPO_PUBLIC_CRAVEUP_LOCATION_ID=

# Exact public HTTPS hosted-checkout origin for the selected environment. Do not infer it from the
# API origin, merchant slug, or a checkout response.
EXPO_PUBLIC_CRAVEUP_CHECKOUT_ORIGIN=

# Optional until the delivery-address lane starts. Google permits only one application-restriction
# type per key, so iOS and Android use separate keys restricted to their own app identifiers and APIs.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# Figma tooling is isolated from Expo configuration. Copy `.env.figma.example` to
# `.env.figma.local`; never place its token in this file.
