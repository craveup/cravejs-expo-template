{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository-local Expo template release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "repository",
    "platform",
    "profile",
    "templateRelease",
    "templateCommit",
    "templateIntegrity",
    "minimumCliVersion",
    "configSchemaVersion",
    "configSchemaSha256",
    "sdkPackage",
    "sdkVersion",
    "sdkIntegrity",
    "apiRelease",
    "openapiSha256",
    "templateManifestSha256",
    "packageManager",
    "generateCommand",
    "verifyCommand",
    "startCommand"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "expo" },
    "repository": { "const": "craveup/cravejs-expo-template" },
    "platform": { "const": "expo" },
    "profile": { "const": "template" },
    "templateRelease": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "templateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "templateIntegrity": {
      "type": "string",
      "pattern": "^sha256-(?:[A-Za-z0-9+/]{4}){10}[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=$"
    },
    "minimumCliVersion": { "const": "2.0.0" },
    "configSchemaVersion": { "const": "1.0.0" },
    "configSchemaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sdkPackage": { "const": "@craveup/storefront-sdk" },
    "sdkVersion": { "const": "2.0.1" },
    "sdkIntegrity": {
      "type": "string",
      "pattern": "^sha512-(?:[A-Za-z0-9+/]{4}){21}[A-Za-z0-9+/][AQgw]==$"
    },
    "apiRelease": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "openapiSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "templateManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packageManager": { "const": "npm" },
    "generateCommand": { "const": "npm run template:materialize" },
    "verifyCommand": { "const": "npm run verify" },
    "startCommand": { "const": "npx expo start" }
  }
}
